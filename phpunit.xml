<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    bootstrap="vendor/autoload.php"
    colors="true"
    processIsolation="true"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd">

   <testsuites>
    <testsuite name="Application Test Suite">
        <directory suffix="Test.php">./tests/Unit</directory>
        <directory suffix="Test.php">./tests/casts</directory>
	<directory suffix="Test.php">./tests/Console</directory>
        <directory suffix="Test.php">./tests/Feature</directory>
        <directory suffix="Test.php">./tests/Integration</directory>
        <directory suffix="Test.php">./tests/Payment</directory>
        <directory suffix="Test.php">./tests/Pdf</directory>
        <directory suffix="Test.php">./tests/DataMapper</directory>
        <directory suffix="Test.php">./tests/Events</directory>
        <directory suffix="Test.php">./tests/Export</directory>
        <directory suffix="Test.php">./tests/Filters</directory>
        <directory suffix="Test.php">./tests/Helpers</directory>
    </testsuite>
</testsuites>


    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="invoice_ninja_test"/>
        <env name="DB_USERNAME" value="invoicetest"/>
        <env name="DB_PASSWORD" value="testpassword"/>
    </php>
    
     <source>
    <include>
        <directory suffix=".php">app</directory>
    </include>
    <exclude>
        <directory>tests</directory>
    </exclude>
</source>



    
</phpunit>

