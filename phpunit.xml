               <directory suffix="Test.php">./tests/Events</directory>
                 <directory suffix="Test.php">./tests/Exceptions</directory>
                 <directory suffix="Test.php">./tests/Export</directory>
                  <directory suffix="Test.php">./tests/Feature</directory>
                 <directory suffix="Test.php">./tests/Filters</directory>
                 <directory suffix="Test.php">./tests/Helper</directory>
                  <directory suffix="Test.php">./tests/Helpers</directory>
                   <directory suffix="Test.php">./tests/http</directory>
                       <directory suffix="Test.php">./tests/Imports</directory>
       <directory suffix="Test.php">./tests/Integration</directory>
            <directory suffix="Test.php">./tests/Job</directory>
                 <directory suffix="Test.php">./tests/Listeners</directory>
                      <directory suffix="Test.php">./tests/Livewire</directory>
                      <directory suffix="Test.php">./tests/Mail</directory>
                      <directory suffix="Test.php">./tests/Mock</directory>
                           <directory suffix="Test.php">./tests/Notifications</directory>
